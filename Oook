--// FETCH SERVERS
local searching = false

local function fetchServers()
    if searching then return end
    searching = true
    Refresh.Text = "กำลังค้นหา..."
    Status.Text = "กำลังโหลดรายการเซิร์ฟเวอร์"

    for _, child in ipairs(List:GetChildren()) do
        if child:IsA("Frame") then
            child:Destroy()
        end
    end

    task.spawn(function()
        local servers = {}
        local cursor = nil
        local pages = 0
        local failed = false

        repeat
            pages += 1

            local url = string.format(
                "https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100",
                game.PlaceId
            )

            if cursor then
                url = url .. "&cursor=" .. HttpService:UrlEncode(cursor)
            end

            local ok, response = pcall(function()
                return requestFunc({
                    Url = url,
                    Method = "GET"
                })
            end)

            if not ok or not response or response.StatusCode ~= 200 then
                failed = true
                break
            end

            local decodedOk, data = pcall(function()
                return HttpService:JSONDecode(response.Body)
            end)

            if not decodedOk or type(data) ~= "table" then
                failed = true
                break
            end

            for _, server in ipairs(data.data or {}) do
                if server.playing < server.maxPlayers then
                    table.insert(servers, server)
                end
            end

            cursor = data.nextPageCursor

        until not cursor or pages >= 5

        table.sort(servers, function(a, b)
            return a.playing < b.playing
        end)

        if failed then
            Status.Text = "โหลดไม่สำเร็จ • ลองใหม่อีกครั้ง"
        else
            Status.Text = string.format(
                "พบ %d เซิร์ฟเวอร์ • เรียงจากคนน้อย",
                #servers
            )
        end

        for _, server in ipairs(servers) do
            createServerEntry(server)
        end

        if #servers == 0 and not failed then
            Status.Text = "ไม่พบเซิร์ฟเวอร์ที่ว่าง"
        end

        Refresh.Text = "↻  ค้นหาเซิร์ฟเวอร์"
        searching = false
    end)
end

Refresh.MouseButton1Click:Connect(fetchServers)

